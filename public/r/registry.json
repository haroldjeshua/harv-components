{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "harv",
  "homepage": "https://components.harv.computer",
  "items": [
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "The basic pressable, with modifiers, alert tones, and sizes.",
      "files": [
        {
          "path": "registry/harv/button/button.tsx",
          "type": "registry:ui"
        }
      ],
      "meta": {
        "layer": "element"
      },
      "cssVars": {
        "light": {
          "--bg": "#fafaf8",
          "--border": "rgb(0 0 0 / 0.1)",
          "--duration-fast": "120ms",
          "--ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
          "--fg": "#101010",
          "--radius-sm": "6px",
          "--surface-2": "#f1f0ec"
        },
        "dark": {
          "--bg": "#101010",
          "--border": "rgb(255 255 255 / 0.09)",
          "--duration-fast": "120ms",
          "--ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
          "--fg": "#f5f4f0",
          "--radius-sm": "6px",
          "--surface-2": "#1f1f1f"
        }
      }
    },
    {
      "name": "badge",
      "type": "registry:ui",
      "title": "Badge",
      "description": "Small label for layers, statuses, and tags.",
      "files": [
        {
          "path": "registry/harv/badge/badge.tsx",
          "type": "registry:ui"
        }
      ],
      "meta": {
        "layer": "element"
      },
      "cssVars": {
        "light": {
          "--bg": "#fafaf8",
          "--border": "rgb(0 0 0 / 0.1)",
          "--fg": "#101010",
          "--surface-2": "#f1f0ec"
        },
        "dark": {
          "--bg": "#101010",
          "--border": "rgb(255 255 255 / 0.09)",
          "--fg": "#f5f4f0",
          "--surface-2": "#1f1f1f"
        }
      }
    },
    {
      "name": "temporal-theme",
      "type": "registry:component",
      "title": "Temporal theme",
      "description": "Daylight-following theme: clock in, scheme and warmth out.",
      "dependencies": [
        "lucide-react"
      ],
      "registryDependencies": [
        "popover"
      ],
      "files": [
        {
          "path": "registry/harv/temporal-theme/temporal-theme.ts",
          "type": "registry:lib"
        },
        {
          "path": "registry/harv/temporal-theme/temporal-toggle.tsx",
          "type": "registry:component"
        },
        {
          "path": "registry/harv/temporal-theme/temporal-theme.css",
          "type": "registry:component"
        }
      ],
      "meta": {
        "layer": "system"
      },
      "cssVars": {
        "light": {},
        "dark": {}
      }
    },
    {
      "name": "proximity-navigation",
      "type": "registry:component",
      "title": "Proximity navigation",
      "description": "Scroll-synced rail for long pages. Marks swell near you.",
      "dependencies": [
        "motion"
      ],
      "files": [
        {
          "path": "registry/harv/proximity-navigation/proximity-math.ts",
          "type": "registry:lib"
        },
        {
          "path": "registry/harv/proximity-navigation/proximity-rail.tsx",
          "type": "registry:component"
        }
      ],
      "meta": {
        "layer": "system"
      },
      "cssVars": {
        "light": {},
        "dark": {}
      }
    }
  ]
